{
    "name": "diogo/pdi-adapter",
    "description": "Simple customer management application using Design Pattern Adapter",
    "autoload": {
        "psr-4": {
            "Diogo\\PdiAdapter\\Application\\": "src/Application",
            "Diogo\\PdiAdapter\\Domain\\": "src/Domain",
            "Diogo\\PdiAdapter\\Infrastructure\\": "src/Infrastructure"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "test/"
        }
    },
    "require": {
        "php": "^8.1",
        "league/climate": "^3.8",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "@stable",
        "vimeo/psalm": "@stable",
        "squizlabs/php_codesniffer": "@stable",
        "phpstan/phpstan": "@stable",
        "rector/rector": "@stable",
        "infection/infection": "@stable",
        "phpunit/php-code-coverage": "@stable",
        "sebastian/diff": "@stable"
    },
    "scripts": {
        "unit-test": "phpunit --no-coverage --do-not-cache-result --colors=always test/",
        "phpcs-check": "phpcs --exclude=Generic.WhiteSpace.DisallowTabIndent --standard=PSR1,PSR2,PSR12 src/ test/",
        "phpcs-fix": "phpcbf",
        "phpstan": "phpstan analyse --level=6 src/ test/",
        "psalm": "psalm --no-cache",
        "rector": "rector process --dry-run --debug",
        "coverage": "XDEBUG_MODE=coverage phpunit --do-not-cache-result"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
